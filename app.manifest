<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Application manifest, embedded by app.rc as RT_MANIFEST id 1.

  The point of this file is the first dependency: without an explicit
  dependency on Microsoft.Windows.Common-Controls 6.0.0.0 the loader binds the
  process to the Windows 5.x copy of comctl32.dll, and every native control
  (the downloader's ListView, buttons, progress bar, combo boxes) draws in the
  flat Windows 95 style. Declaring the v6 assembly makes the same controls pick
  up the modern themed look - no code change needed.

  processorArchitecture and language stay "*" so the same binary works on x86,
  x64 and ARM64 and with any system language.

  asInvoker: neither exe ever needs elevation, and asking for it would make the
  downloader fail to write into a folder next to the exe.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="CppSekai" version="1.0.0.3" processorArchitecture="*"/>
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0" processorArchitecture="*" publicKeyToken="6595b64144ccf1df"
        language="*"/>
    </dependentAssembly>
  </dependency>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
