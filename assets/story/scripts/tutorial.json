{
  "version": 1,
  "scripts": [
    {
      "id": "tutorial",
      "steps": [
        {
          "id": "open",
          "type": "scene",
          "text": "初次见面！\nCppSekai",
          "hold": 1.7
        },
        {
          "id": "intro1",
          "who": "初音未来",
          "text": "哇——！你终于来啦！这里是 CppSekai，一个可以打 Project SEKAI 谱面的地方哦～",
          "hold": 0
        },
        {
          "who": "初音未来",
          "text": "判定、连击、结算、多人游玩……能照着原作做的，我们都做进去了。要不要花两分钟，我带你转一圈？"
        },
        {
          "id": "ask_start",
          "type": "choice",
          "who": "初音未来",
          "text": "现在就开始吗？",
          "options": [
            {
              "text": "开始吧！",
              "goto": "settings"
            },
            {
              "text": "我自己先看看",
              "goto": "bye"
            }
          ]
        },
        {
          "id": "settings",
          "who": "初音未来",
          "text": "先调音符速度吧！设置 → 演奏 → 音符速度。新手用 7～9 刚刚好，太快眼睛会跟不上，太慢音符会挤成一团哦。",
          "do": "openSettings",
          "highlight": "settings.speed",
          "tip": "音符速度先调到 7～9！",
          "passthrough": true,
          "wait": "settingsClosed",
          "done": true
        },
        {
          "id": "after_settings",
          "who": "初音未来",
          "text": "旁边的「延迟」也可以看看～总觉得按早了或者按晚了，就在那里微调。其它先保持默认就好！"
        },
        {
          "id": "ask_charts",
          "type": "choice",
          "who": "初音未来",
          "text": "你的 charts 文件夹里，已经有谱面了吗？",
          "options": [
            {
              "text": "还没有，教教我！",
              "goto": "dl_intro"
            },
            {
              "text": "已经有了",
              "goto": "device"
            }
          ]
        },
        {
          "id": "dl_intro",
          "who": "初音未来",
          "text": "那就先点右上角的「下载谱面」吧！会打开官谱下载器哦。",
          "highlight": "store",
          "tip": "点这里打开下载器～",
          "wait": "chartdlOpen",
          "timeout": 30,
          "onTimeout": "dl_offer"
        },
        {
          "id": "dl_offer",
          "type": "choice",
          "who": "初音未来",
          "text": "诶？没找到那个按钮吗……要我帮你打开吗？",
          "options": [
            {
              "text": "帮我打开",
              "goto": "dl_launch"
            },
            {
              "text": "先跳过下载",
              "goto": "device"
            }
          ]
        },
        {
          "id": "dl_launch",
          "who": "初音未来",
          "text": "好啦，下载器打开了！",
          "do": "launchChartdl",
          "wait": "chartdlOpen",
          "timeout": 25,
          "onTimeout": "dl_failed"
        },
        {
          "id": "dl_search",
          "who": "初音未来",
          "text": "在「搜索」框里打歌名就好～中文、日文、罗马音都认得，比如 Hype Dive！",
          "wait": "chartdlSearch",
          "timeout": 120,
          "onTimeout": "dl_slow",
          "onClose": "dl_closed",
          "guide": "search",
          "tip": "这里输入歌名"
        },
        {
          "id": "dl_pick",
          "who": "初音未来",
          "text": "然后在这边的列表里，点一首你想打的歌～",
          "wait": "chartdlSong",
          "timeout": 120,
          "onTimeout": "dl_slow",
          "onClose": "dl_closed",
          "guide": "list",
          "tip": "点一下你要的那首"
        },
        {
          "id": "dl_easy",
          "who": "初音未来",
          "text": "右边把 EASY 勾上（绿色那个）！其它难度……先不用啦。",
          "guide": "easy",
          "tip": "勾上 EASY",
          "wait": "chartdlEasy",
          "timeout": 180,
          "onTimeout": "dl_slow",
          "onClose": "dl_closed"
        },
        {
          "id": "dl_go",
          "who": "初音未来",
          "text": "都勾好了，就按「下载勾选的歌曲」，等进度条走完～",
          "wait": "chartdlDone",
          "timeout": 300,
          "onTimeout": "dl_slow",
          "onClose": "dl_closed",
          "guide": "queue",
          "tip": "按这里开始下载"
        },
        {
          "id": "dl_close",
          "who": "初音未来",
          "text": "下好啦！把下载器关掉，回到游戏，谱面就会自己出现在列表里哦。",
          "wait": "chartdlClosed",
          "timeout": 300,
          "onTimeout": "dl_after"
        },
        {
          "id": "dl_after",
          "who": "初音未来",
          "text": "看，谱面已经进来了！我们继续吧～",
          "goto": "device"
        },
        {
          "id": "dl_closed",
          "type": "choice",
          "who": "初音未来",
          "text": "诶，下载器被关掉了……还没下完也没关系！要我重新打开吗？",
          "options": [
            {
              "text": "重新打开",
              "goto": "dl_launch"
            },
            {
              "text": "先跳过下载",
              "goto": "device"
            }
          ]
        },
        {
          "id": "dl_slow",
          "type": "choice",
          "who": "初音未来",
          "text": "这一步好像卡了挺久……慢慢来也没关系，或者先跳过，之后再自己试试？",
          "options": [
            {
              "text": "我自己再试试",
              "goto": "dl_intro"
            },
            {
              "text": "先跳过下载",
              "goto": "device"
            }
          ]
        },
        {
          "id": "dl_failed",
          "type": "choice",
          "who": "初音未来",
          "text": "唔……下载器没能启动。可能是 chartdl.exe 不在游戏目录里？",
          "options": [
            {
              "text": "再试一次",
              "goto": "dl_launch"
            },
            {
              "text": "先跳过下载",
              "goto": "device"
            }
          ]
        },
        {
          "id": "device",
          "type": "choice",
          "who": "初音未来",
          "text": "先问一下～你平时主要用什么设备打歌？触摸屏的话，是手机、平板或者教室那块白板；键盘鼠标就是电脑啦。",
          "options": [
            {
              "text": "触摸屏",
              "goto": "touch_hit"
            },
            {
              "text": "键盘 / 鼠标",
              "goto": "kb_hit"
            }
          ]
        },
        {
          "id": "touch_hit",
          "type": "image",
          "image": "notes_touch.png",
          "caption": "这三种就是你按下的东西：Tap 点、Hold 按住、Flick 划。",
          "who": "初音未来",
          "text": "触摸屏其实就三件事！蓝点轻轻点一下；长条要按住，尾巴到线再松手；带箭头的，就顺着箭头方向划～"
        },
        {
          "id": "touch_hit2",
          "who": "初音未来",
          "text": "绿条中途松手会断连的，所以先慢一点，别急着追速度～"
        },
        {
          "id": "kb_hit",
          "type": "keys",
          "caption": "上面就是你现在的键位（设置 → 演奏 → 按键映射 可以改）",
          "who": "初音未来",
          "text": "键盘这边，你现在绑的 12 个键就是屏幕上这些。蓝点按一下，长条按住不放，Flick 按对应的键就算向上划哦！"
        },
        {
          "id": "kb_hit2",
          "who": "初音未来",
          "text": "鼠标也能点音符～想换键位的话，去 设置 → 演奏 → 按键映射，改成自己顺手的就好。"
        },
        {
          "id": "play",
          "who": "初音未来",
          "text": "来试试吧！右边点一首歌，难度点 EASY（绿色）——新手先从这个开始最稳。想挑战别的难度也完全可以～",
          "box": "left",
          "passthrough": true,
          "highlight": "phone"
        },
        {
          "id": "play_wait",
          "who": "初音未来",
          "text": "选好之后按「确定」，我在这里等你哦，打完回来我们聊聊多人模式～",
          "highlight": "phone",
          "wait": "playStarted",
          "box": "left",
          "passthrough": true
        },
        {
          "id": "after_play",
          "who": "初音未来",
          "text": "欢迎回来！手感不对的话，回去把音符速度和延迟再调一调，比硬练有用得多哦。"
        },
        {
          "id": "mp_ask",
          "type": "choice",
          "who": "初音未来",
          "text": "最后～想顺便了解一下多人游玩吗？",
          "options": [
            {
              "text": "想了解！",
              "goto": "mp1"
            },
            {
              "text": "不用啦",
              "goto": "bye"
            }
          ]
        },
        {
          "id": "mp1",
          "who": "初音未来",
          "text": "多人游玩是在同一台电脑上开好几个窗口：一个当房主选歌，其它窗口各自选难度，然后一起开始！"
        },
        {
          "id": "mp2",
          "who": "初音未来",
          "text": "去 设置 → 系统 打开「允许多开」，再打开「多人游玩」，重启游戏就能用啦。键盘和触摸屏混着玩也可以哦～"
        },
        {
          "id": "bye",
          "who": "初音未来",
          "text": "那就这样啦，玩得开心！想再听我讲一遍，就去 设置 → 关于 → 重播新手教学～"
        }
      ]
    }
  ]
}
