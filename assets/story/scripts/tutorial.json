{
  "version": 1,
  "scripts": [
    {
      "id": "tutorial",
      "steps": [
        {
          "id": "open",
          "type": "scene",
          "text": "「世界」的狭缝",
          "hold": 1.7
        },
        {
          "id": "intro1",
          "who": "初音未来",
          "text": "你好。\n很少有人来这里呢。",
          "hold": 0
        },
        {
          "who": "初音未来",
          "text": "我叫初音未来。\n你叫什么名字？"
        },
        {
          "id": "name",
          "type": "name",
          "who": "初音未来",
          "text": "",
          "maxLen": 10
        },
        {
          "who": "初音未来",
          "text": "……真是个好听的名字呢！"
        },
        {
          "who": "初音未来",
          "text": "你是从其他世界过来的吧。"
        },
        {
          "id": "ask_start",
          "type": "choice",
          "who": "初音未来",
          "text": "呵呵呵，\n我对你那边的世界也非常熟悉哦。",
          "options": [
            {
              "text": "“这里是……？”",
              "goto": "where"
            },
            {
              "text": "“为什么我看不到你？”",
              "goto": "see"
            }
          ]
        },
        {
          "id": "see",
          "who": "xxt8582753（程序作者）",
          "text": "要不你帮我跟试驾谈，把Miku的版权拿过来？",
          "goto": "see_1"
        },
        {
          "id": "see_1",
          "who": "奏",
          "text": "所以这里是……「空无一人的世界」吗？",
          "goto": "see_2"
        },
        {
          "id": "see_2",
          "who": "xxt8582753（程序作者）",
          "text": "……先等Miku把话说完吧，你们25时等下再来。",
          "goto": "where"
        },
        {
          "id": "where",
          "who": "初音未来",
          "text": "这里是「世界」的狭缝。",
          "goto": "where_1"
        },
        {
          "id": "where_1",
          "who": "初音未来",
          "text": "聚集着无数的心愿，\n由此会诞生出无数的「世界」。",
          "goto": "where_2"
        },
        {
          "id": "where_2",
          "who": "初音未来",
          "text": "「世界」是从心愿中诞生的奇妙之地哦。\n有多少心愿就会有多少个「世界」，它们的样子也各不相同。",
          "goto": "where_3"
        },
        {
          "id": "where_3",
          "who": "初音未来",
          "text": "如果拥有愿望的人能在「世界」中找到自己“真正的心愿”，\n那么歌曲就会从那份心愿中诞生。",
          "goto": "where_4"
        },
        {
          "id": "where_4",
          "who": "初音未来",
          "text": "所以，“「世界」中的我们”也在等待并协助每个来到这里的人找到自己真正的心愿。",
          "goto": "where_5"
        },
        {
          "id": "where_5",
          "who": "初音未来",
          "text": "其实每个人的内心深处都有着强烈的愿望。",
          "goto": "where_6"
        },
        {
          "id": "where_6",
          "who": "初音未来",
          "text": "当然，你的心中也一样。",
          "goto": "where_7"
        },
        {
          "id": "where_7",
          "who": "初音未来",
          "text": "……对了，你要不要和我一起唱首歌？",
          "goto": "where_8"
        },
        {
          "id": "where_8",
          "who": "初音未来",
          "text": "歌曲一定会\n让我们的心紧紧相连的。",
          "goto": "ask_start_1"
        },
        {
          "id": "ask_start_1",
          "type": "choice",
          "who": "初音未来",
          "text": "那么，快告诉我你的心愿吧！",
          "options": [
            {
              "text": "开始吧！",
              "goto": "settings"
            },
            {
              "text": "我自己先看看",
              "goto": "bye"
            }
          ]
        },
        {
          "id": "settings",
          "who": "初音未来",
          "text": "先调音符速度吧！太快眼睛会跟不上，太慢音符会挤成一团哦。",
          "do": "openSettings",
          "highlight": "settings.speed",
          "tip": "音符速度先调到 7～9！",
          "passthrough": true,
          "wait": "settingsClosed",
          "done": true
        },
        {
          "id": "ask_charts",
          "type": "choice",
          "who": "初音未来",
          "text": "你已经有谱面了吗？",
          "options": [
            {
              "text": "还没有，教教我！",
              "goto": "dl_intro"
            },
            {
              "text": "已经有了",
              "goto": "device"
            }
          ]
        },
        {
          "id": "dl_intro",
          "who": "初音未来",
          "text": "那就先下载谱面吧！",
          "highlight": "store",
          "tip": "点这里打开下载器～",
          "wait": "chartdlOpen",
          "timeout": 45,
          "onTimeout": "dl_offer",
          "passthrough": true,
          "goto": "dl_launch"
        },
        {
          "id": "dl_offer",
          "type": "choice",
          "who": "初音未来",
          "text": "诶？没找到那个按钮吗……要我帮你打开吗？",
          "options": [
            {
              "text": "帮我打开",
              "goto": "dl_launch"
            },
            {
              "text": "先跳过下载",
              "goto": "device"
            }
          ],
          "wait": "chartdlOpen"
        },
        {
          "id": "dl_launch",
          "who": "初音未来",
          "text": "好啦，下载器打开了！",
          "do": "launchChartdl",
          "wait": "chartdlOpen",
          "timeout": 25,
          "onTimeout": "dl_failed"
        },
        {
          "id": "dl_list",
          "who": "初音未来",
          "text": "想和我唱什么歌呢？",
          "wait": "chartdlSong",
          "timeout": 180,
          "onTimeout": "dl_slow",
          "onClose": "dl_closed",
          "guide": "list",
          "tip": "勾上你要的歌",
          "goto": "dl_go"
        },
        {
          "id": "dl_go",
          "who": "初音未来",
          "text": "",
          "wait": "chartdlDone",
          "timeout": 300,
          "onTimeout": "dl_slow",
          "onClose": "dl_closed",
          "guide": "queue",
          "tip": "按这里开始下载"
        },
        {
          "id": "dl_close",
          "who": "初音未来",
          "text": "下好啦！把下载器关掉，回到游戏，谱面就会自己出现在列表里哦。",
          "wait": "chartdlClosed",
          "timeout": 300,
          "onTimeout": "dl_after"
        },
        {
          "id": "dl_after",
          "who": "初音未来",
          "text": "看，谱面已经进来了！我们继续吧～",
          "goto": "device"
        },
        {
          "id": "dl_closed",
          "type": "choice",
          "who": "初音未来",
          "text": "诶，下载器被关掉了……还没下完也没关系！要我重新打开吗？",
          "options": [
            {
              "text": "重新打开",
              "goto": "dl_launch"
            },
            {
              "text": "先跳过下载",
              "goto": "device"
            }
          ]
        },
        {
          "id": "dl_slow",
          "type": "choice",
          "who": "初音未来",
          "text": "这一步好像卡了挺久……慢慢来也没关系，或者先跳过，之后再自己试试？",
          "options": [
            {
              "text": "我自己再试试",
              "goto": "dl_intro"
            },
            {
              "text": "先跳过下载",
              "goto": "device"
            }
          ]
        },
        {
          "id": "dl_failed",
          "type": "choice",
          "who": "初音未来",
          "text": "唔……下载器没能启动。可能是 chartdl.exe 不在游戏目录里？",
          "options": [
            {
              "text": "再试一次",
              "goto": "dl_launch"
            },
            {
              "text": "跳过下载",
              "goto": "device"
            }
          ]
        },
        {
          "id": "device",
          "type": "choice",
          "who": "初音未来",
          "text": "你正在使用什么设备呢？",
          "options": [
            {
              "text": "触摸屏",
              "goto": "touch_hit"
            },
            {
              "text": "键盘/鼠标",
              "goto": "kb_hit"
            }
          ]
        },
        {
          "id": "touch_hit",
          "type": "say",
          "who": "初音未来",
          "text": "触摸屏的操作很简单……当音符落在判定线时，轻轻触摸屏幕！"
        },
        {
          "id": "kb_hit",
          "type": "keys",
          "caption": "尝试在游戏中按下轨道对应的按键吧！",
          "who": "初音未来",
          "text": "就像中二节奏一样，演出时按下对应的按键就可以了，遇到带箭头的音符也可以直接按下！",
          "action": "openKeymap",
          "actionLabel": "修改键位"
        },
        {
          "id": "play",
          "who": "初音未来",
          "text": "来试试吧！",
          "box": "left",
          "passthrough": true,
          "highlight": "phone"
        },
        {
          "id": "play_wait",
          "who": "初音未来",
          "text": "准备好的话就开始吧",
          "highlight": "phone",
          "wait": "playStarted",
          "box": "left",
          "passthrough": true
        },
        {
          "id": "after_play",
          "who": "初音未来",
          "text": "欢迎回来！"
        },
        {
          "id": "mp_ask",
          "type": "choice",
          "who": "初音未来",
          "text": "最后～想顺便了解一下多人演出吗？",
          "options": [
            {
              "text": "想了解！",
              "goto": "mp1"
            },
            {
              "text": "不用啦",
              "goto": "bye"
            }
          ]
        },
        {
          "id": "mp1",
          "who": "初音未来",
          "text": "多人演出是在同一台电脑上开好几个窗口\n打开「允许多开」，再打开「多人游玩」，重启游戏就能用啦！"
        },
        {
          "id": "bye",
          "who": "初音未来",
          "text": "好了，那让我们与新歌相会吧！"
        }
      ]
    }
  ]
}
